generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ── Better Auth core schema (MongoDB) ──────────────────────────────
// Field names/shapes follow Better Auth's required schema exactly.
// `role` is an extra field (see user.additionalFields in src/lib/auth.ts)
// used for EduNexus's admin / teacher / student access control.

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  phone         String?
  location      String?
  department    String?
  bio           String?
  role          String    @default("student") // "admin" | "teacher" | "student"

  // ── Login lockout tracking (3 bhul password dile 5 ghonta lock) ──
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?


# MongoDB connection string (must point at a replica set — Atlas free tier works out of the box).
# Prisma's Mongo connector needs a replica set to support transactions used by relational writes.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/edunexus?retryWrites=true&w=majority"

# Random secret used to sign/encrypt sessions & cookies. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"

# Base URL of THIS server (Better Auth uses it to build absolute callback/verification links).
BETTER_AUTH_URL="http://localhost:5000"

# Port the Express server listens on.
PORT=5000

# Comma-separated list of origins allowed to call this API with credentials (your Next.js app).
CLIENT_ORIGIN="http://localhost:3000"

# Optional. Groq API key, used only server-side to generate the natural-
# language performance insight notes for the At-Risk (teacher) and My
# Performance (student) pages. If this is left unset, those features
# still work — a built-in, rule-based note is used instead. Set this
# only if you want the notes written by an LLM. Get a free key (no
# credit card required) at https://console.groq.com
# Note: Groq is a different company from Grok/xAI — easy to mix up.
GROQ_API_KEY=""

# Optional — Groq model to use for insights, only read when GROQ_API_KEY
# is set. Defaults to llama-3.3-70b-versatile.
GROQ_MODEL="llama-3.3-70b-versatile"
